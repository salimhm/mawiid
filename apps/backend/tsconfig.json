{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "paths": {
            "@db/*": ["./src/db/*"],
            "@lib/*": ["./src/lib/*"],
            "@module/*": ["./src/module/*"],
            "@storage/*": ["./src/storage/*"],
            "@contracts/*": ["../../packages/contracts/src/*"],
        }
    },
    "include": ["src/**/*.ts", "rule/**/*.ts"]
}
