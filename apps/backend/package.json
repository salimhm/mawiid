{
    "name": "@mawiid/backend",
    "private": true,
    "type": "module",
    "module": "src/app.ts",
    "scripts": {
        "dev": "bun run --env-file=../../.env --watch src/app.ts",
        "typecheck": "bun x tsc --noEmit",
        "test": "bun test src",
        "db:migrate:main": "bun x prisma migrate dev --config prisma.main.config.ts",
        "db:migrate:tenant": "bun x prisma migrate dev --config prisma.tenant.config.ts",
        "db:generate": "bun x prisma generate --config prisma.main.config.ts && bun x prisma generate --config prisma.tenant.config.ts",
        "db:deploy:main": "bun run --env-file=../../.env src/db/migrate.db.ts",
        "db:seed": "bun run --env-file=../../.env scripts/seed.ts"
    },
    "dependencies": {
        "@elysiajs/openapi": "1.4.16",
        "@libsql/client": "^0.18.0",
        "@prisma/adapter-libsql": "7",
        "@prisma/client": "7",
        "elysia": "^1.4.30",
        "livekit-client": "^2.23.0",
        "livekit-server-sdk": "^2.19.1"
    },
    "devDependencies": {
        "@types/bun": "1.4.2",
        "@types/node": "^26.6.5",
        "prisma": "7",
        "typescript": "5.9.3"
    }
}
