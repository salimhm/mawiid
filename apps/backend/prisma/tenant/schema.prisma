generator client {
  provider        = "prisma-client"
  output          = "../../src/db/generated/tenant"
  previewFeatures = ["partialIndexes"]
}


datasource db {
  provider = "sqlite"
}

model File {
  fileId    String    @id @map("file_id")
  fileName  String?   @map("file_name")
  userId    Int       @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt], map: "file_deleted_at_idx")
  @@map("file")
}

model Access {
  accessId  Int       @id @default(autoincrement()) @map("access_id")
  userId    Int       @map("user_id")
  actions   Json      @default("[]")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  // One active access row per user; soft-deleted rows don't count
  @@unique([userId], map: "access_user_id_idx", where: { deletedAt: null })
  @@index([deletedAt], map: "access_deleted_at_idx")
  @@map("access")
}
