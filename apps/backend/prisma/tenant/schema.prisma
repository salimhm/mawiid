generator client {
  provider        = "prisma-client"
  output          = "../../src/db/generated/tenant"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model File {
  file_id    String    @id
  file_name  String?
  user_id    Int
  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@index([deleted_at], map: "file_deleted_at_idx")
  @@map("file")
}

model Access {
  access_id  Int       @id @default(autoincrement())
  user_id    Int
  actions    Json      @default("[]")
  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@unique([user_id], map: "access_user_id_idx", where: { deleted_at: null })
  @@index([deleted_at], map: "access_deleted_at_idx")
  @@map("access")
}
