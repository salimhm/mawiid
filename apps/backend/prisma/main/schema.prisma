generator client {
  provider        = "prisma-client"
  output          = "../../src/db/generated/main"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

model Organization {
  organization_id   Int          @id @default(autoincrement())
  organization_name String
  created_at        DateTime     @default(now())
  deleted_at        DateTime?
  departments       Department[]

  @@index([organization_name], map: "organization_name_idx")
  @@index([deleted_at], map: "organization_deleted_at_idx")
  @@map("organization")
}

model Department {
  department_id   Int          @id @default(autoincrement())
  organization_id Int
  department_name String
  created_at      DateTime     @default(now())
  deleted_at      DateTime?
  organization    Organization @relation(fields: [organization_id], references: [organization_id])
  members         Member[]

  @@index([organization_id], map: "department_organization_id_idx")
  @@index([department_name], map: "department_name_idx")
  @@index([deleted_at], map: "department_deleted_at_idx")
  @@map("department")
}

model User {
  user_id            Int       @id @default(autoincrement())
  user_phone         String?
  user_username      String?
  user_email         String?
  user_password_hash String?
  user_first_name    String
  user_last_name     String
  user_image         String?
  user_language      String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt
  deleted_at         DateTime?
  members            Member[]

  @@unique([user_phone], map: "user_phone_idx", where: { deleted_at: null })
  @@unique([user_username], map: "user_username_idx", where: { deleted_at: null })
  @@unique([user_email], map: "user_email_idx", where: { deleted_at: null })
  @@index([user_first_name], map: "user_first_name_idx")
  @@index([user_last_name], map: "user_last_name_idx")
  @@index([deleted_at], map: "user_deleted_at_idx")
  @@map("user")
}

model Member {
  member_id     Int        @id @default(autoincrement())
  user_id       Int
  department_id Int
  created_at    DateTime   @default(now())
  deleted_at    DateTime?
  user          User       @relation(fields: [user_id], references: [user_id])
  department    Department @relation(fields: [department_id], references: [department_id])

  @@unique([user_id, department_id], map: "member_user_id_department_id_idx", where: { deleted_at: null })
  @@index([department_id], map: "member_department_id_idx")
  @@index([deleted_at], map: "member_deleted_at_idx")
  @@map("member")
}

model Vault {
  vault_id           Int         @id @default(autoincrement())
  vault_owner_type   String
  vault_owner_id     Int
  vault_database_url String
  created_at         DateTime    @default(now())
  deleted_at         DateTime?
  room_routes        RoomRoute[]

  @@unique([vault_owner_type, vault_owner_id], map: "vault_owner_type_owner_id_idx", where: { deleted_at: null })
  @@index([deleted_at], map: "vault_deleted_at_idx")
  @@map("vault")
}

model RoomRoute {
  room_route_id Int       @id @default(autoincrement())
  room_uid      String
  vault_id      Int
  created_at    DateTime  @default(now())
  deleted_at    DateTime?
  vault         Vault     @relation(fields: [vault_id], references: [vault_id])

  @@unique([room_uid], map: "room_route_room_uid_idx")
  @@index([vault_id], map: "room_route_vault_id_idx")
  @@index([deleted_at], map: "room_route_deleted_at_idx")
  @@map("room_route")
}
