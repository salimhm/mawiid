# Production settings for infra/compose. `make mawiid` copies this to .env.production on the
# first run and fills every empty secret below with a random value; edit the copy, never this file.

APP_NAME=mawiid
ENV=production

# Public hostnames. Both need an A record to this server's public IPv4 (DNS only, no proxy).
APP_DOMAIN=mawiid.laedxdigitalstudio.com
RTC_DOMAIN=rtc.mawiid.laedxdigitalstudio.com

# Generated when empty.
JWT_SECRET_KEY=
LIVEKIT_API_KEY=mawiid-production
LIVEKIT_API_SECRET=
INTERNAL_SERVICE_TOKEN=

# Email (registration and password reset). Gmail needs an app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
GOOGLE_APP_PASSWORD=

# Database. The defaults keep everything in SQLite files in the backend_data volume: no account
# needed. For Turso, set TURSODB_URL=libsql://<database>-<org>.turso.io and the real values below
# (TURSODB_TOKEN: main database, TURSODB_GROUP_TOKEN: vaults, TURSODB_API_TOKEN: Platform API).
TURSODB_URL=file:/data/main.db
TURSODB_TOKEN=local
TURSODB_DB=local
TURSODB_ORG=local
TURSODB_GROUP_NAME=mawiid
TURSODB_GROUP_TOKEN=local
TURSODB_API_TOKEN=
DB_MAX_CACHED_TENANTS=100

# AI translation worker. Filled by make mawiid from the hardware when empty:
# AI_CUDA=1 and MAWIID_MT_MODEL=10b with an NVIDIA GPU, AI_CUDA=0 and 3b without.
LIVEKIT_TRANSLATOR_AGENT=mawiid-translator
AI_CUDA=
MAWIID_MT_MODEL=
MAWIID_STT_WHISPER_MODEL=small
MAWIID_STT_WHISPER_DEVICE=auto
MAWIID_MT_DEVICE=auto
