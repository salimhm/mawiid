# APP_DOMAIN and RTC_DOMAIN come from .env.production (docker-compose.yml passes them in).
{$APP_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # Service-to-service routes stay on the Docker network: LiveKit posts webhooks and the AI
  # worker saves transcripts straight to backend:3000. The API description is not published.
  @private path /api/transcript/internal* /api/webhook/* /api/openapi*
  handle @private {
    respond 404
  }

  # handle_path removes /api before forwarding, matching the backend routes.
  handle_path /api/* {
    reverse_proxy backend:3000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

# Caddy terminates TLS and upgrades WebSocket connections for LiveKit signaling.
{$RTC_DOMAIN} {
  reverse_proxy livekit:7880
}
