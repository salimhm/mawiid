# Phase 5 smoke test: everything on GPU 0, one room, finals only, no transcript saving.
# Copy to /workspace/mawiid-run/env/staging-smoke.env, chmod 600, replace every REPLACE_ME.

# Identity. Staging names must end in -staging; BACKEND_AGENT_NAME is the VM's LIVEKIT_TRANSLATOR_AGENT.
LIVEKIT_TRANSLATOR_AGENT=mawiid-translator-staging
BACKEND_AGENT_NAME=REPLACE_ME
LIVEKIT_URL=wss://REPLACE_ME
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# GPU fence: only GPU 0 exists for this process.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# Models (persistent workspace, no downloads at runtime)
MAWIID_MODELS_DIR=/workspace/mawiid-run/models
HF_HOME=/workspace/mawiid-run/hf-cache
HF_HUB_OFFLINE=1
MAWIID_LANGUAGES=en-US,fr-FR,ar-SA,ar-MA
MAWIID_STT_WHISPER_MODEL=large-v3-turbo
MAWIID_STT_WHISPER_DEVICE=cuda
MAWIID_STT_WHISPER_DEVICE_INDEX=0
MAWIID_STT_WHISPER_NUM_WORKERS=1
MAWIID_MT_MODEL=3b
MAWIID_MT_DEVICE=cuda
MAWIID_MT_DEVICE_INDEX=0
MAWIID_MT_INTER_THREADS=1
MAWIID_MT_CPU_BACKUP=0
MAWIID_STT_PARTIALS=0
MAWIID_MT_PARTIALS=0

# Voxtral Realtime (Darija speakers who pick "I speak: Darija"), served by vLLM on GPU 3.
# The worker only connects to it over loopback; it never loads anything on GPU 3. Needs patch P2.
MAWIID_STT_VOXTRAL_ENABLED=1
MAWIID_STT_VOXTRAL_URL=ws://127.0.0.1:8000/v1/realtime
MAWIID_STT_VOXTRAL_MODEL=mistralai/Voxtral-Mini-4B-Realtime-Arabic

# Admission, logs, metrics
MAWIID_AGENT_MAX_ROOMS=1
MAWIID_METRICS_HOST=127.0.0.1
MAWIID_METRICS_PORT=9464
MAWIID_LOG_FILE=/workspace/mawiid-run/logs/worker.log
MAWIID_STAGE_TIMINGS=1
