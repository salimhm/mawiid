APP_NAME=mawiid
ENV=dev

BACKEND_PORT=
PUBLIC_SERVER_URL=
PUBLIC_APP_URL=https://localhost:3100
# Signs access tokens (HS256). At least 32 random characters outside dev: openssl rand -base64 48
JWT_SECRET_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
GOOGLE_APP_PASSWORD=

# Upstash TCP connection (TLS). Use redis://localhost:6379 for local Redis.
REDIS_URL=rediss://default:<password>@<endpoint>:6379

TURSODB_URL=libsql://<database>-<org>.turso.io
TURSODB_TOKEN=
TURSODB_DB=
TURSODB_ORG=
TURSODB_GROUP_NAME=mawiid-dev
# SQL token for the Mawiid group; not a Platform API provisioning token.
TURSODB_GROUP_TOKEN=
# Platform API token (turso auth api-tokens mint mawiid): creates a personal vault database on a user's first room.
# Not needed when TURSODB_URL is a local file: vaults are then SQLite files next to it.
TURSODB_API_TOKEN=
DB_MAX_CACHED_TENANTS=100

LIVEKIT_URL=ws://livekit:7880
# Browser-facing URL returned by POST /room/join when LiveKit is behind TLS.
# Leave unset for local development if LIVEKIT_URL is already browser-reachable.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI translation worker (services/ai, `make ai`). The backend dispatches it into rooms by this name.
LIVEKIT_TRANSLATOR_AGENT=mawiid-translator
# Shared by the backend and the worker: the worker saves transcripts with POST /transcript/internal.
# At least 32 random characters: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=
MAWIID_BACKEND_URL=http://localhost:3000
# Model settings read by the worker (services/ai/README.md): auto | cpu | cuda
MAWIID_STT_WHISPER_MODEL=small
MAWIID_STT_WHISPER_DEVICE=auto
MAWIID_MT_DEVICE=auto
# Converted MADLAD-400 model; without it, captions stay in the spoken language.
# MAWIID_MT_MODEL_PATH=services/ai/data/models/madlad400-3b-mt-ct2


LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
